# FeeCore Backend Configuration
DATABASE_URL="postgresql://postgres:admin@localhost:5432/feecore?schema=public"
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# JWT Configuration (In production, JWT_SECRET MUST be set via environment variable to a secure key with >= 32 characters)
JWT_SECRET="feecore-dev-secret-super-secure-key-32-chars-min"
JWT_EXPIRES_IN="8h"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Allowed CORS Origins (comma-separated for multiple origins, e.g. "https://app.example.com,https://admin.example.com")
CORS_ORIGIN="http://localhost:5180,http://localhost:5173"
