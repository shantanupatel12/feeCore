# FeeCore Web Frontend Configuration

# Base API path for requests and receipt downloads/prints.
# In production, default is /api/v1 (recommended for reverse proxies / single-origin deployments)
# or set to the complete API URL (e.g. https://api.yourdomain.com/api/v1)
VITE_API_BASE_URL=/api/v1

# Local development proxy target (used ONLY by the Vite dev server proxy; NOT baked into production client logic)
VITE_BACKEND_URL=http://localhost:4000
